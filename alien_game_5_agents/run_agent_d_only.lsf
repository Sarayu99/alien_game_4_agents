#!/bin/bash
#BSUB -J alien_game_agent_d_only
#BSUB -o /home/sarayu_anshuman/summer_research_2026/alien_game_5_agents/agent_d_only.%J.out
#BSUB -e /home/sarayu_anshuman/summer_research_2026/alien_game_5_agents/agent_d_only.%J.err
#BSUB -n 1
#BSUB -W 1:00
#BSUB -q normal
#BSUB -u sarayu_anshuman@berkeley.edu

# Log start details
echo "Job started on: $(hostname)"
echo "Job started at: $(date)"

cd ~/summer_research_2026/alien_game_5_agents

source ~/.bashrc

# Activate your Python-specific environment
source /apps/anaconda3/bin/activate summer_research_2026_env

echo "PWD: $(pwd)"
echo "Python: $(which python)"

# Agent D makes NO API calls, so no ANTHROPIC_API_KEY is needed.
# (agents.py imports claude_client, which only needs the anthropic package installed.)

export PYTHONUNBUFFERED=1

# Agent D only: N = 24 trials per episode, E = 100 episodes, 50 replications per K.
# Epsilon values come from EPSILON_VALUES at the top of run_agent_d_only.py
# (or add e.g.  --eps 0.4 0.5 0.6 0.7  to the end of the python line below).
/home/sarayu_anshuman/.conda/envs/summer_research_2026_env/bin/python -u /home/sarayu_anshuman/summer_research_2026/alien_game_5_agents/run_agent_d_only.py --trials 24 --episodes 100 --reps 50

echo "Job finished at: $(date)"